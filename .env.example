# Required for the private lead workspace in production
LEAD_PORTAL_PASSWORD=replace-with-a-strong-password
LEAD_PORTAL_SECRET=replace-with-a-long-random-secret

# Required for durable lead storage in production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: enables GA4 page and conversion event collection
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# DailyByte deployment used by stable /dailybyte/* redirect routes.
# Recommended production host: https://dailybyte.ensaar.com
DAILYBYTE_URL=https://dailybyte.ensaar.com

# Existing Ensaar certificate registry service used by the /verify proxy
CERTIFICATE_API_URL=https://verify.ensaar.com
