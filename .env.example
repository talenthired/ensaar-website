# Required for Basecamp, the private admin panel at /basecamp, in production.
# LEAD_PORTAL_PASSWORD / LEAD_PORTAL_SECRET still work as legacy aliases.
BASECAMP_PASSWORD=replace-with-a-strong-password
BASECAMP_SECRET=replace-with-a-long-random-secret

# Required in production for durable storage of contact submissions and events.
# Apply supabase/leads.sql, supabase/events.sql, and supabase/security.sql to
# the project first. security.sql supplies durable Basecamp sessions and shared
# rate limiting; Basecamp login fails closed without it in production.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: enables GA4 page and conversion event collection
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# DailyByte deployment used by stable /dailybyte/* redirect routes.
# The DailyByte product origin. NEXT_PUBLIC_ is the one the marketing
# components render; DAILYBYTE_URL overrides it for the redirect route only.
NEXT_PUBLIC_DAILYBYTE_URL=https://dailybytepro.com

# Shared with DailyByte's SUPPORT_BRIDGE_SECRET. This stays server-side and
# sends Ensaar live support conversations into the DailyByte admin inbox.
SUPPORT_BRIDGE_SECRET=replace-with-at-least-32-random-bytes
DAILYBYTE_SUPPORT_API_URL=https://dailybytepro.com/api/support/bridge

# Existing Ensaar certificate registry service used by the /verify proxy
CERTIFICATE_API_URL=https://verify.ensaar.com

# --- Basecamp durable store (Railway Postgres) -------------------------------
# Attach the Postgres service and Railway injects this. Required for Basecamp
# writes: people, invitations, events and registrations. Reads fall back to the
# seeded content when it is absent, so a misconfigured deploy degrades to a
# read-only public site rather than a blank one.
# The schema is applied by `npm run db:migrate`, which runs as the Railway
# preDeploy step and is idempotent.
DATABASE_URL=

# Invitations are sent with Resend when this is set. Without it the invite link
# is shown in Basecamp to copy and send manually, so invitations still work.
RESEND_API_KEY=
EMAIL_FROM=

# Break-glass only. The shared BASECAMP_PASSWORD login closes automatically once
# a named, active owner exists, because it is an unattributable owner-level key
# to EOR client data. Set to 1 temporarily if every owner is locked out.
BASECAMP_ALLOW_SHARED_LOGIN=

# Only when the site really sits behind Cloudflare. Otherwise a caller can set
# cf-connecting-ip themselves and reset every rate limit (seen on Railway).
TRUST_CLOUDFLARE_IP=

# Extra addresses (comma-separated) told about new leads and EOR signatures,
# on top of every active Basecamp owner and admin.
EOR_NOTIFY_EMAIL=

# Leave RESEND_API_KEY unset until EMAIL_FROM's domain is verified in Resend.
# With a key but an unverified domain, every send fails while the site believes
# email works (customers would wait for signing codes that never arrive).
